{
  "name": "@autopilot/dashboard",
  "version": "0.1.0",
  "private": true,
  "description": "AUTOPILOT dashboard — the localhost read-only web control panel.",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "bin": {
    "autopilot-dashboard": "./dist/control/cli.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -b",
    "prepack": "pnpm run build",
    "start": "node dist/server/main.js"
  },
  "dependencies": {
    "@autopilot/engine": "workspace:*",
    "@autopilot/mcp": "workspace:*",
    "@autopilot/onboarding": "workspace:*",
    "@autopilot/store": "workspace:*",
    "@autopilot/tokens": "workspace:*",
    "esbuild": "0.28.2"
  }
}

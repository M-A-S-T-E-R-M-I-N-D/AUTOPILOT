  "scripts": {
    "setup": "node scripts/setup.mjs",
    "build": "tsc -b",
    "typecheck": "tsc -p packages/tokens/tsconfig.typecheck.json --noEmit && tsc -p packages/store/tsconfig.typecheck.json --noEmit && tsc -p packages/engine/tsconfig.typecheck.json --noEmit && tsc -p packages/onboarding/tsconfig.typecheck.json --noEmit && tsc -p packages/mcp/tsconfig.typecheck.json --noEmit && tsc -p apps/dashboard/tsconfig.typecheck.json --noEmit && tsc -p apps/dashboard/e2e/tsconfig.json --noEmit && tsc -p tsconfig.typecheck.json --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:impacted": "vitest run --changed HEAD~1 && pnpm run test:registry-guards",
    "test:registry-guards": "vitest run apps/dashboard/test/flight/pr-review.test.ts apps/dashboard/test/tooling/generate-splice-manifest.test.ts apps/dashboard/test/tooling/chunks.test.ts apps/dashboard/test/server/client-bundle-size-budget.test.ts",

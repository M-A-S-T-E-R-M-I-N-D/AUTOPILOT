    "dashboard": "pnpm run build && node apps/dashboard/dist/server/main.js",
    "dashboard:start": "pnpm run build && node apps/dashboard/dist/control/cli.js start",
    "dashboard:stop": "node apps/dashboard/dist/control/cli.js stop",
    "dashboard:status": "node apps/dashboard/dist/control/cli.js status",
    "dashboard:restart": "pnpm run build && node apps/dashboard/dist/control/cli.js restart",
    "dashboard:doctor": "node apps/dashboard/dist/control/cli.js doctor",
    "dashboard:ci-status": "node apps/dashboard/dist/control/cli.js ci-status",
    "dashboard:maintenance-sweep": "node apps/dashboard/dist/control/cli.js maintenance-sweep",

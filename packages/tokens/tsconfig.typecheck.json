{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "composite": false,
    "declaration": false,
    "declarationMap": false,
    "incremental": true,
    "tsBuildInfoFile": "../../node_modules/.cache/typecheck/tokens.tsbuildinfo",
    "noEmit": true,
    "rootDir": "../.."
  },
  "include": ["src/**/*.ts", "test/**/*.ts"]
}

{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "composite": false,
    "declaration": false,
    "declarationMap": false,
    "incremental": true,
    "tsBuildInfoFile": "../../node_modules/.cache/typecheck/engine.tsbuildinfo",
    "noEmit": true,
    "rootDir": "../..",
    "paths": {
      "@autopilot/store": ["../store/src/index.ts"]
    }
  },
  "include": ["src/**/*.ts", "test/**/*.ts"]
}
